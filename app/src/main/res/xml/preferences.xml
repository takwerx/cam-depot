<?xml version="1.0" encoding="utf-8"?>
<!--
    Cam Depot has no settings: the catalog address is fixed, and every other
    choice is made on the panel where it belongs. This screen exists so the
    manual has somewhere to be reached from. ATAK surfaces a plugin's
    documentation through its Tool Preferences entry, and without one the PDF
    ships inside the APK with no way for anyone to open it, which has already
    happened once in this repo.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <com.atakmap.android.gui.PanPreference
        android:key="manual"
        android:title="@string/manual_title"
        android:summary="@string/manual_summary" />

</PreferenceScreen>
